{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). It lives
 ;; in the kotoba-lang org of this workspace (transferred + renamed from
 ;; com-junkawasaki/langgraph-clj / com-junkawasaki/langchain-clj).
 ;;
 ;; This cargo-handling vertical is an OPERATIONS COORDINATION actor
 ;; (load/unload/manifest data logging, crane/dock/warehouse handling
 ;; scheduling proposals, weight-limit/hazmat-segregation/securing-
 ;; failure safety-concern flagging, crane/handling-equipment
 ;; maintenance coordination) -- it never itself holds load-safety
 ;; clearance authority (see `cargohandling.governor`'s
 ;; `finalize-load-safety-violations`: any proposal to directly
 ;; finalize a load-safety clearance is a hard, permanent block, and
 ;; the closed op-allowlist contains no such op in the first place).
 ;; This repo is standalone (forkable outside the workspace); the
 ;; :local/root paths only resolve inside the monorepo checkout -- a
 ;; standalone fork should override them with git coordinates.
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system"
         :git/sha "83db99546eabc53613ae826ea41d1533a3c574af"}
io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/langgraph"}
        ;; shared langchain.db store seam (EDN-blob codec + identity
        ;; schema + field-spec entity helpers) -- this store is an
        ;; entity-store adopter (ADR-2607141600), NOT a hand-rolled
        ;; enc/dec* copy.
        io.github.kotoba-lang/langchain-store
        {:local/root "../../kotoba-lang/langchain-store"}}
 :aliases
 {;; offline workspace dev -- pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  ;; clojure -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "cargohandling.sim"]}
  ;; clojure -M:dev:render-html [out-file] -> regenerate docs/samples/operator-console.html
  ;; through the real actor (flagship checklist item 2, ADR-2607189300 Wave5 seq 6).
  :render-html {:main-opts ["-m" "cargohandling.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
